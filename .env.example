# SmartVoyage 环境变量示例（复制为 .env 后填写，勿提交到版本控制）
# 所有值均为占位符：DASHSCOPE_API_KEY 请替换为你自己的百炼 Key（sk- 开头）
DASHSCOPE_API_KEY=sk-replace-me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.6-plus
LLM_TEMPERATURE=0.1

# MySQL（SV_ 前缀优先于通用 MYSQL_*，避免与本机其他项目同名变量串库）
SV_MYSQL_HOST=127.0.0.1
SV_MYSQL_PORT=3306
SV_MYSQL_USER=smart_yoyage
# 本地演示口令，仅作占位；部署到公网前请改为强口令
SV_MYSQL_PASSWORD=changeme
SV_MYSQL_DATABASE=travel_rag
# 初始化脚本使用管理员账号建库建号（需具备 CREATE DATABASE / CREATE USER 权限）
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=changeme

# 天气数据源：database（教学模拟数据） / api（和风天气实时接口）
WEATHER_SOURCE=database
HEFENG_WEATHER_API_KEY=
HEFENG_API_HOST=https://your-api-host.re.qweatherapi.com

# RAG 向量检索：安装 pymilvus 且 Milvus 可用时自动启用，否则使用本地语义检索
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
EMBEDDING_DIM=1024

# 服务地址（Docker 部署时改为容器服务名）
WEATHER_A2A_URL=http://127.0.0.1:5005
TICKET_A2A_URL=http://127.0.0.1:5006
TRIP_A2A_URL=http://127.0.0.1:5007
WEATHER_MCP_URL=http://127.0.0.1:8002/mcp
TICKET_MCP_URL=http://127.0.0.1:8001/mcp
TRIP_MCP_URL=http://127.0.0.1:8003/mcp

# 调试开关：1 = 使用规则式本地 LLM，不调用外部 API（用于离线测试）
SV_OFFLINE=0
# MySQL 不可用时是否自动降级到 SQLite（保证项目始终可运行）
SV_DB_FALLBACK=1
